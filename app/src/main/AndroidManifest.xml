<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pleos Vehicle SDK 공개 읽기 권한 (protectionLevel="normal", SDK 소스 PleosPermission 기준). 제어(CONTROL_*) 권한은 쓰지 않는다. -->
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />

    <!-- Android Automotive 표준 차량 속성: 속도·에너지(런타임 요청), 기어, 비상등 -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.car.permission.CAR_ENERGY" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="android.car.permission.CAR_EXTERIOR_LIGHTS" />

    <!-- 기록 순간 시스템 알림 (Android 13+ 런타임 허용) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 한마디 증상 (v0.8): 운전자가 첫 실행 화면에서 켤 때만 요청, 기본 꺼짐 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android 11+ 에서 음성 인식 서비스가 있는지 확인하려면 필요 -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_truelog"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
